<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen cards (PLANNING.md §7): two receivers, the settings screen the launcher opens on
  a placement and a long press, and what keeps the cards fresh. No permission of their own. Glance
  brings WorkManager, with its WAKE_LOCK (held by a job while it runs), RECEIVE_BOOT_COMPLETED (to
  re-arm its jobs after a reboot), FOREGROUND_SERVICE and ACCESS_NETWORK_STATE (which lets nothing
  leave the phone: there is no INTERNET permission); all left as WorkManager declares them
  (PLANNING.md §10). The midnight alarm is AlarmManager.set(RTC): inexact, non-wakeup, no
  permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:supportsRtl="true">
        <!-- Reached from the launcher's placement and reconfigure flow. Exported, because the
             launcher starts it; taskAffinity empty, so it never lands on top of the app's task. -->
        <activity
            android:name=".config.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tetto.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- exported=false: the system delivers APPWIDGET_* to them regardless. -->
        <receiver
            android:name=".glance.GlanceWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_glance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glance_info" />
        </receiver>
        <receiver
            android:name=".words.WordsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_words_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_words_info" />
        </receiver>

        <!-- The midnight alarm: Tetto's own pending intent, nobody else's. -->
        <receiver
            android:name=".refresh.MidnightReceiver"
            android:exported="false" />

        <!-- The broadcasts Android exempts from the implicit-broadcast limits, sent by the system
             alone; exported=false still receives them. -->
        <receiver
            android:name=".refresh.WidgetSystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
