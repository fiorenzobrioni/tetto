<resources>
    <!-- The two cards, as the launcher's picker names them (PLANNING.md §7). -->
    <string name="widget_glance_label">At a glance</string>
    <string name="widget_glance_desc">Your caps, each with what is left and a slim bar. A touch on one adds a spend.</string>
    <string name="widget_words_label">In words</string>
    <string name="widget_words_desc">One cap in a ring, and what is left in words. A touch adds a spend.</string>

    <!-- The static previews: sample values only. -->
    <string name="widget_preview_left">€12 left</string>
    <string name="widget_preview_line">Coffee · until Sunday</string>
    <string name="widget_preview_pace">about €4\na day</string>
    <string name="widget_preview_cap1">Coffee</string>
    <string name="widget_preview_fig1">€12</string>
    <string name="widget_preview_cap2">Groceries</string>
    <string name="widget_preview_fig2">€62</string>
    <string name="widget_preview_cap3">Eating out</string>
    <string name="widget_preview_fig3">€48</string>
    <string name="widget_preview_cap4">Transport</string>
    <string name="widget_preview_cap5">Fun</string>

    <!-- Until when: the period's last day, included; and when a cap over starts again. -->
    <string name="widget_until_today">today</string>
    <string name="widget_until_tomorrow">until tomorrow</string>
    <string name="widget_until_day">until %s</string>
    <string name="widget_again_tomorrow">tomorrow</string>
    <string name="widget_again_day">on %s</string>
    <!-- How a date beyond the next six days is written, as a date skeleton. -->
    <string name="widget_skeleton_date">dMMM</string>

    <!-- What is left: "€12 left", "€30 over"; the word alone, under a one-cell figure. -->
    <string name="widget_left">%s left</string>
    <string name="widget_over">%s over</string>
    <string name="widget_word_left">left</string>
    <string name="widget_word_over">over</string>
    <!-- Whether the word stands over the figure ("ancora / 12 €") or under it ("€12 / left"). -->
    <bool name="widget_word_above">false</bool>

    <!-- The lines under it. -->
    <string name="widget_detail">of %1$s · %2$s</string>
    <string name="widget_detail_over">of %1$s · starts again %2$s</string>
    <string name="widget_line">%1$s · %2$s</string>
    <string name="widget_line_over">%1$s · starts again %2$s</string>
    <string name="widget_of">of %s</string>
    <string name="widget_starts_again">starts again %s</string>
    <string name="widget_pace">about %s a day</string>
    <string name="widget_pace_short">%s a day</string>

    <!-- «In words»'s sentence, on a tall card (PLANNING.md §7). -->
    <string name="widget_note_pace">about %s a day</string>
    <string name="widget_note_ahead_pace">ahead of the days: about %s a day</string>
    <string name="widget_note_ahead">spending ahead of the days</string>
    <string name="widget_note_ahead_short">ahead of the days</string>
    <string name="widget_note_reserve">with %s in reserve</string>
    <string name="widget_note_forgiven">forgiven when it starts again</string>

    <!-- What TalkBack reads for a cap, one sentence, as on the caps screen. -->
    <string name="widget_description_left">%1$s, %2$s left of %3$s, %4$s</string>
    <string name="widget_description_over">%1$s, %2$s over its cap of %3$s, starts again %4$s</string>
