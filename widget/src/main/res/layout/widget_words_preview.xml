<?xml version="1.0" encoding="utf-8"?>
<!--
  «In words» as the launcher's picker draws it where it asks for a static layout: sample values in
  the default dress, the row of the default 4×1 placement: the ring at the leading edge, what is
  left at 20 sp Medium over the cap and its last day at 16 sp, the pace at the far edge.
  Sample data only: a preview is a drawing of the product, never a reading.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_preview_ring" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/widget_preview_left"
            android:textColor="@color/widget_preview_ink"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/widget_preview_line"
            android:textColor="@color/widget_preview_ink_dim"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:maxLines="2"
        android:text="@string/widget_preview_pace"
        android:textColor="@color/widget_preview_ink_dim"
        android:textSize="16sp" />
</LinearLayout>
