<?xml version="1.0" encoding="utf-8"?>
<!--
  «In words» (PLANNING.md §7), the family's ring card: one cap in the family's circle, and the
  words. Placed four cells by one; at least one cell; no maximum. Pushed, never polled, as
  «At a glance»; the settings screen is optional.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.callbackdev.tetto.widget.config.WidgetConfigActivity"
    android:description="@string/widget_words_desc"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_words_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
