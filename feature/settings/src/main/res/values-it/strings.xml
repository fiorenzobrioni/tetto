<resources>
    <string name="settings_title">Impostazioni</string>

    <!-- Il denaro. -->
    <string name="settings_group_money">Denaro</string>
    <string name="settings_currency_explanation">Tetto conta in una sola valuta. Cambiarla cambia il simbolo dei tuoi importi; non li converte mai.</string>
    <string name="settings_currency_confirm_title">Contare in %s?</string>
    <string name="settings_currency_confirm_body">I tuoi tetti, le loro riserve e le tue spese tengono le loro cifre, nella nuova valuta: Tetto non converte mai da una valuta all’altra.</string>
    <string name="settings_currency_confirm_rounded">Ha meno decimali, quindi gli importi si arrotondano: %1$s diventa %2$s.</string>
    <string name="settings_currency_confirm">Cambia</string>
    <string name="settings_month_start">Inizio del mese</string>
    <!-- "Giorno 27 · questo mese: 27 ott – 26 nov". -->
    <string name="settings_month_start_value">Giorno %1$s · questo mese: %2$s</string>
    <string name="settings_month_start_explanation">I tetti mensili ripartono in questo giorno, quelli annuali in questo giorno di gennaio. Un mese troppo corto parte dal suo ultimo giorno. I periodi in corso dei tetti mensili e annuali si spostano sulle nuove date, con le loro spese.</string>
    <string name="settings_week_start">Inizio della settimana</string>
    <string name="settings_week_start_phone">%s, come il telefono</string>
    <string name="settings_week_start_explanation">I tetti settimanali ripartono in questo giorno. Il loro periodo in corso si sposta sulle nuove date, con le sue spese.</string>

