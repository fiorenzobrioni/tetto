    <string name="data_backup">Back up to a file</string>
    <!-- "4 caps and 37 spends, with your settings, in a file you choose". -->
    <string name="data_backup_note">%1$s and %2$s, with your settings, in a file you choose</string>
    <string name="data_backup_note_empty">No caps yet: the file would hold your settings alone</string>
