<resources>
    <string name="settings_title">Settings</string>

    <!-- The guide's card, first in the list (PLANNING.md §11 Phase 6). -->
    <string name="settings_guide">How Tetto works</string>
    <string name="settings_guide_note">The caps and their periods, the reserve, the numpad, the home screen, your data</string>

    <!-- The money (PLANNING.md §4.1, §4.2, §4.5). -->
    <string name="settings_group_money">Money</string>
    <string name="settings_currency_explanation">Tetto counts in one currency. Changing it relabels your amounts; it never converts them.</string>
    <string name="settings_currency_confirm_title">Count in %s?</string>
    <string name="settings_currency_confirm_body">Your caps, their reserves and your spends keep their figures, in the new currency: Tetto never converts between currencies.</string>
    <string name="settings_currency_confirm_rounded">It has fewer decimals, so amounts are rounded: %1$s becomes %2$s.</string>
    <string name="settings_currency_confirm">Change</string>
    <string name="settings_month_start">Start of the month</string>
    <!-- "Day 27 · this month: 27 Oct – 26 Nov". -->
    <string name="settings_month_start_value">Day %1$s · this month: %2$s</string>
    <string name="settings_month_start_explanation">Monthly caps start again on this day; yearly ones always on 1 January. A month too short for it starts on its last day. The current periods of your monthly caps move to the new dates, with their spends.</string>
    <string name="settings_week_start">Start of the week</string>
    <string name="settings_week_start_phone">%s, as the phone</string>
    <string name="settings_week_start_explanation">Weekly caps start again on this day. Their current period moves to the new dates, with its spends.</string>

    <!-- The evening reminder (PLANNING.md §8). -->
    <string name="settings_group_reminder">Reminder</string>
    <string name="settings_reminder">Evening reminder</string>
    <!-- "“Anything to add today?” around 20:30, only on a day with no spend added". -->
    <string name="settings_reminder_note">“Anything to add today?” around %s, only on a day with no spend added</string>
    <string name="settings_reminder_time">Time</string>
    <string name="settings_reminder_time_note">Around this time: to save battery, Android may bring it a few minutes later.</string>
    <string name="settings_save">Save</string>
    <!-- When the reminder is on and Android would drop it: why, and the one thing that fixes it. -->
    <string name="settings_reminder_ask_title">Tetto may not notify you yet</string>
    <string name="settings_reminder_ask_body">The reminder is a notification, and Android asks you once whether Tetto may send them.</string>
    <string name="settings_reminder_ask_action">Allow</string>
    <string name="settings_reminder_blocked_title">Notifications are off for Tetto</string>
    <string name="settings_reminder_blocked_channel_title">The reminder’s notifications are off</string>
    <string name="settings_reminder_blocked_body">The reminder cannot arrive until they are on again, in the phone’s settings.</string>
    <string name="settings_reminder_blocked_action">Open settings</string>

    <!-- The appearance, the family's. -->
    <string name="settings_group_appearance">Appearance</string>
    <string name="settings_caps_layout">Caps</string>
    <string name="settings_caps_layout_tiles">Tiles</string>
    <string name="settings_caps_layout_list">List</string>
    <string name="settings_caps_layout_note">Tiles, two by two, show each cap’s pace and reserve too. The list puts one cap on a row, shorter, so more of them fit on the screen: the pace and the reserve are in the cap’s sheet.</string>
    <string name="settings_theme">Theme</string>
    <string name="settings_theme_system">Same as the phone</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_palette">Palette</string>
    <string name="settings_palette_paper">Paper</string>
    <string name="settings_palette_vivid">Vivid</string>
    <string name="settings_palette_note">Paper is warm white and amber. Vivid is cool white and azure.</string>
    <string name="settings_font">Typeface</string>
    <string name="settings_font_google_sans">Google Sans</string>
    <string name="settings_font_inter">Inter</string>
    <string name="settings_font_system">System</string>
    <string name="settings_font_note">Google Sans and Inter come with the app, so they look the same on every phone. System takes the font your phone is set in.</string>
    <string name="settings_dynamic_color">Wallpaper colors</string>
    <string name="settings_dynamic_color_note">The colors come from your wallpaper instead of the palette above.</string>
