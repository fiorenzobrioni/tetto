    <string name="data_erase_note">Every cap, spend and setting, from this phone: Tetto starts again from its first run</string>
    <string name="data_busy_writing">Writing the file…</string>
    <string name="data_busy_reading">Reading the file…</string>
    <string name="data_busy_restoring">Restoring…</string>
    <string name="data_busy_erasing">Erasing…</string>

    <!-- Before a restore: what the file holds and what it replaces. -->
    <string name="data_restore_title">Restore this backup?</string>
    <!-- "Written on 5 Nov 2026, 21:14 by Tetto 0.1.0." -->
    <string name="data_restore_written">Written on %1$s by Tetto %2$s.</string>
    <string name="data_restore_written_unversioned">Written on %1$s.</string>
    <!-- "4 caps: Coffee, Groceries, Shopping and Travel". -->
    <plurals name="data_restore_caps">
        <item quantity="one">%1$d cap: %2$s</item>
        <item quantity="other">%1$d caps: %2$s</item>
    </plurals>
    <!-- The last of the names listed, when there are more: "Coffee, Groceries, Shopping and 2 more". -->
    <string name="data_restore_more">%d more</string>
    <string name="data_restore_no_caps">No caps: your settings alone</string>
    <!-- "Amounts in Swiss Franc". -->
    <string name="data_restore_currency">Amounts in %s</string>
    <plurals name="data_restore_replaces">
        <item quantity="one">It replaces the cap on this phone, with its spends, and your settings. This cannot be undone.</item>
        <item quantity="other">It replaces the %d caps on this phone, with their spends, and your settings. This cannot be undone.</item>
    </plurals>
    <string name="data_restore_settings">Your settings become the backup’s too.</string>
    <string name="data_restore_confirm">Restore</string>

    <!-- Before erasing everything. -->
    <string name="data_erase_title">Erase everything?</string>
    <plurals name="data_erase_body">
        <item quantity="one">Your cap, its spends and its reserve, and your settings, are erased from this phone, and Tetto starts again from its first run. A backup you saved is not touched. This cannot be undone.</item>
        <item quantity="other">Your %d caps, their spends and their reserves, and your settings, are erased from this phone, and Tetto starts again from its first run. A backup you saved is not touched. This cannot be undone.</item>
    </plurals>
    <string name="data_erase_body_empty">Your settings are erased from this phone, and Tetto starts again from its first run. This cannot be undone.</string>
    <string name="data_erase_confirm">Erase</string>

    <!-- What an export or a restore came to, on a card until it is put away. -->
    <string name="data_ok">OK</string>
    <string name="data_saved_title">Backup saved</string>
    <!-- "4 caps and 37 spends, with your settings, in tetto-backup-2026-11-05.json. …". -->
    <string name="data_saved_body">%1$s and %2$s, with your settings, in %3$s. The file is not encrypted: keep it somewhere private.</string>
    <string name="data_saved_body_unnamed">%1$s and %2$s, with your settings. The file is not encrypted: keep it somewhere private.</string>
    <string name="data_spends_saved_title">Spends saved</string>
    <string name="data_spends_saved_body">%1$s, one row each, in %2$s.</string>
    <string name="data_spends_saved_body_unnamed">%1$s, one row each.</string>
    <string name="data_restored_title">Backup restored</string>
    <!-- "4 caps and 37 spends are back, with your settings. …". -->
    <string name="data_restored_body">%1$s and %2$s are back, with your settings. A period that ended since the backup was made has closed.</string>
    <string name="data_restored_body_empty">Your settings are back.</string>
    <string name="data_failed_write_title">The file could not be written</string>
    <string name="data_failed_write_body">The place you chose refused it, or has no room left. Nothing changed in Tetto.</string>
    <string name="data_failed_read_title">The file could not be read</string>
    <string name="data_failed_read_body">It may have been moved, or be too large to be a backup. Nothing changed.</string>
    <string name="data_failed_not_tetto_title">Not a Tetto backup</string>
    <string name="data_failed_not_tetto_body">This file was not written by Tetto’s “Back up to a file”. Nothing changed.</string>
    <string name="data_failed_too_new_title">A backup from a newer Tetto</string>
    <string name="data_failed_too_new_body">Update Tetto to restore it. Nothing changed.</string>
    <string name="data_failed_damaged_title">The backup is damaged</string>
    <string name="data_failed_damaged_body">It is cut short, or was changed by hand, so its figures cannot be trusted. Nothing changed.</string>
    <string name="data_failed_restore_title">The backup could not be restored</string>
    <string name="data_failed_restore_body">Something went wrong while it was written. Your caps and settings are as they were.</string>

