    <!-- Il suggerimento del primo giorno: come leggere una scheda, e la strada per la guida. -->
    <string name="tip_title">Come leggere un tetto</string>
    <string name="tip_body">La cifra grande è quanto puoi ancora spendere, fino al giorno scritto sotto. La linea sottile sulla barra è oggi: una barra che la supera vuol dire spese in anticipo sui giorni. La guida spiega il resto.</string>
    <string name="tip_open">Apri la guida</string>
    <string name="tip_dismiss">Ho capito</string>

