<resources>
    <!-- The caps screen. "Left" is what can still be spent; "over" is past the cap (VISION's glossary). -->
    <string name="caps_empty_title">No caps yet</string>
    <string name="caps_empty_body">A cap is what you allow yourself for one thing, by the day, the week, the month or the year. What is left, and until when, will be here.</string>
