<resources>
    <!-- The caps screen. "Left" is what can still be spent; "over" is past the cap (VISION's glossary). -->
    <string name="caps_empty_title">No caps yet</string>
    <string name="caps_empty_body">A cap is what you allow yourself for one thing, by the day, the week, the month or the year. What is left, and until when, will be here.</string>
    <string name="new_cap">New cap</string>
    <string name="change_order">Change the order</string>
    <string name="open_settings">Settings</string>

    <!-- The first day's tip (PLANNING.md §11 Phase 6): how to read a tile, and the way to the guide. -->
    <string name="tip_title">How to read a cap</string>
    <string name="tip_body">The large figure is what you can still spend, until the day written under it. The thin line across the bar is today: a bar that runs past it is spending ahead of the days. The guide explains the rest.</string>
    <string name="tip_open">Open the guide</string>
    <string name="tip_dismiss">Got it</string>

    <!-- The sentence on top (PLANNING.md §4.6): a cap over first, then one renewed today, then all under. -->
    <string name="sentence_one_under">%1$s: %2$s left %3$s.</string>
    <string name="sentence_nothing_spent">All under your caps.</string>
    <string name="sentence_all_under">All under your caps. %1$s is the closest: %2$s left %3$s.</string>
    <string name="sentence_over_one">%1$s is %2$s over. It starts again %3$s.</string>
    <plurals name="sentence_over_some">
        <item quantity="one">%1$s and %2$d other cap are over. %1$s starts again %3$s.</item>
        <item quantity="other">%1$s and %2$d other caps are over. %1$s starts again %3$s.</item>
    </plurals>
    <string name="sentence_over_every">Every cap is over. %1$s starts again %2$s.</string>
    <string name="sentence_renewed_one">%1$s starts again today: %2$s %3$s.</string>
    <plurals name="sentence_renewed_some">
        <item quantity="one">%1$s and %2$d other cap start again today.</item>
        <item quantity="other">%1$s and %2$d other caps start again today.</item>
    </plurals>

