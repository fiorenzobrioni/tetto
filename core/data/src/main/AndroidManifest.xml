<?xml version="1.0" encoding="utf-8"?>
<!--
  The lock (owner, 6 Nov 2026; PLANNING.md §10): the phone's own fingerprint, face or screen lock,
  asked through the platform's BiometricPrompt. USE_BIOMETRIC is a normal permission, granted at
  install, and not in §10's forbidden list; it reads nothing and sends nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
